{
  "name": "beltworks",
  "version": "1.0.0-beta.1",
  "private": true,
  "type": "module",
  "description": "A factory-automation game for the browser.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:test": "vite build --mode test",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools/bench",
    "test": "vitest run",
    "test:bench": "vitest run -c tools/bench/vitest.config.ts",
    "test:e2e": "playwright test",
    "profile:render": "playwright test -c playwright.profile.config.ts",
    "test:release": "playwright test -c playwright.release.config.ts",
    "test:gpu": "playwright test -c playwright.gpu.config.ts",
    "bench": "vite build -c tools/bench/vite.config.ts && node --expose-gc node_modules/.cache/beltworks-bench/run.js",
    "bench:splitters": "vite build -c tools/bench/vite.config.ts && node node_modules/.cache/beltworks-bench/splitters.js",
    "art": "node tools/art/art.js"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.64.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
